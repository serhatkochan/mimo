<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Mimo</AssemblyName>
    <RootNamespace>Mimo</RootNamespace>
    <Version>1.0.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Mimo</Product>
    <Company>Serhat Koçhan</Company>
    <ApplicationIcon>Assets\mimo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Sounds\*.wav" />
    <Resource Include="Assets\mimo.ico" />
    <Resource Include="Assets\Mascots\catalog.json" />
    <Resource Include="Assets\Mascots\snail.*;Assets\Mascots\cactus.*;Assets\Mascots\jellyfish.*;Assets\Mascots\ghost.*;Assets\Mascots\bee.*;Assets\Mascots\capybara.*;Assets\Mascots\mushroom.*;Assets\Mascots\crab.*;Assets\Mascots\seal.*;Assets\Mascots\teapot.*" />
  </ItemGroup>
</Project>
